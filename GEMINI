local function submitPromptToGemini(rawPrompt, isAuto)
	local cleanPrompt = string.match(rawPrompt or "", "^%s*(.-)%s*$")
	if cleanPrompt == "" then return end

	if not isAuto then
		LatestPromptText = cleanPrompt
	end

	local keyToUse = findApiKeyFromGui()
	if keyToUse == "" then
		if not isAuto then
			ResponseParagraph:Set({
				Title = "Gemini Response",
				Content = "Please paste your Api key above and tap GEMINI OFFICIAL GOOGLE AI first."
			})
		end
		return
	end

	local modelToUse = (SelectedModel == "Auto (Find Working Model)") and LockedWorkingModel or SelectedModel
	if not isAuto then
		ResponseParagraph:Set({
			Title = "Gemini Response (" .. modelToUse .. ")",
			Content = "Thinking..."
		})
	end

	task.spawn(function()
		if isAuto then
			AutoAnswerBusy = true
		end

		local ok, replyOrErr = sendToModel(keyToUse, modelToUse, cleanPrompt)
		if ok then
			LatestReplyText = replyOrErr
			ResponseParagraph:Set({
				Title = (isAuto and "Auto Answer (" or "Gemini Response (") .. modelToUse .. ")",
				Content = replyOrErr
			})
		elseif not isAuto then
			LatestReplyText = replyOrErr
			ResponseParagraph:Set({
				Title = "Gemini Response Error",
				Content = replyOrErr
			})
		end

		if isAuto then
			AutoAnswerBusy = false
		end
	end)
end

-- Trigger automatic answer when Hearing: detects a voice or audio spike while Listen & Auto Answers are active
local function checkAutoAnswerFromHearing()
	if not AutoAnswersEnabled or not ListeningEnabled or AutoAnswerBusy then
		return
	end
	if LatestLoudness < 15 then
		return
	end

	local now = os.clock()
	if (now - LastAutoAnswerTime) < 6 then
		return
	end

	local sig = tostring(LatestSoundName) .. ":" .. tostring(LatestSoundCategory)
	if sig == LastHeardSignature and (now - LastAutoAnswerTime) < 12 then
		return
	end

	LastAutoAnswerTime = now
	LastHeardSignature = sig

	local autoPrompt = string.format(
		"In the game, Hearing detected: %s. Briefly explain what it likely is and how it sounds or works in 1 or 2 short sentences.",
		LatestHearingSummary
	)
	submitPromptToGemini(autoPrompt, true)
end

