local function classifySound(soundObj, loudness)
	local n = string.lower((soundObj and soundObj.Name) or "")
	local p = string.lower((soundObj and soundObj.Parent and soundObj.Parent.Name) or "")
	local combined = n .. " " .. p

	if string.find(combined, "voice") or string.find(combined, "speech") or string.find(combined, "talk")
		or string.find(combined, "chat") or string.find(combined, "dialog") or string.find(combined, "vc")
		or string.find(combined, "radio") or string.find(combined, "say") then
		return "VOICE"
	elseif loudness >= 120 then
		return "BEAT/HIT"
	elseif loudness >= 25 then
		return "AUDIO"
	elseif loudness > 1 then
		return "SOFT"
	end
	return "QUIET"
end

local function isCharacterPart(inst)
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr.Character and inst:IsDescendantOf(plr.Character) then
			return true
		end
	end
	return false
end

local function scanGameSight()
	local localPlayer = Players.LocalPlayer
	local char = localPlayer and localPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")

	local hpText = hum and (tostring(math.floor(hum.Health)) .. "/" .. tostring(math.floor(hum.MaxHealth))) or "N/A"
	local posText = root and string.format("(%.0f, %.0f, %.0f)", root.Position.X, root.Position.Y, root.Position.Z) or "NoChar"

	local nearbyPlayers = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= localPlayer and plr.Character then
			local pRoot = plr.Character:FindFirstChild("HumanoidRootPart")
			if root and pRoot then
				local dist = (pRoot.Position - root.Position).Magnitude
				if dist <= 60 then
					table.insert(nearbyPlayers, string.format("%s [%.0fm]", plr.Name, dist))
				end
			else
				table.insert(nearbyPlayers, plr.Name)
			end
		end
	end

	local closestObjName = "None"
	local closestDist = math.huge
	local scanned = 0

	if root then
		for _, obj in ipairs(workspace:GetDescendants()) do
			scanned += 1
			if scanned > 650 then break end
			if obj:IsA("BasePart") and obj.Transparency < 1 and not isCharacterPart(obj) then
				local d = (obj.Position - root.Position).Magnitude
				if d < closestDist and d > 0.5 then
					closestDist = d
					closestObjName = (obj.Parent and obj.Parent ~= workspace and obj.Parent.Name) or obj.Name
				end
			end
		end
	end

	local timeOfDay = string.sub(tostring(Lighting.TimeOfDay or "12:00:00"), 1, 5)
	local nearStr = (#nearbyPlayers > 0) and table.concat(nearbyPlayers, ", ") or "Nobody close"
	local objStr = (closestDist < math.huge) and string.format("%s (%.0fm)", closestObjName, closestDist) or "Nothing nearby"

	LatestSeeingSummary = string.format(
		"Pos %s | HP %s | Near: %s | Object: %s | Time %s",
		posText,
		hpText,
		nearStr,
		objStr,
		timeOfDay
	)

	SeeingLabel:Set("Seeing: " .. LatestSeeingSummary)
end

local function scanGameAudio()
	local loudestSound = nil
	local maxLoud = 0
	local activeCount = 0

	local roots = { workspace, SoundService }
	local localPlayer = Players.LocalPlayer
	if localPlayer then
		local char = localPlayer.Character
		local pGui = localPlayer:FindFirstChildOfClass("PlayerGui")
		if char then table.insert(roots, char) end
		if pGui then table.insert(roots, pGui) end
	end

	for _, root in ipairs(roots) do
		for _, obj in ipairs(root:GetDescendants()) do
			if obj:IsA("Sound") and obj.IsPlaying then
				activeCount += 1
				local loud = tonumber(obj.PlaybackLoudness) or 0
				if loud > maxLoud then
					maxLoud = loud
					loudestSound = obj
				end
			end
		end
	end

	if loudestSound then
		local rounded = math.floor(maxLoud + 0.5)
		local pulseTag = classifySound(loudestSound, rounded)
		LatestSoundName = loudestSound.Name
		LatestLoudness = rounded
		LatestSoundCategory = pulseTag
		LatestHearingSummary = string.format(
			"%s (%s) | Loudness: %d | Active: %d",
			loudestSound.Name,
			pulseTag,
			rounded,
			activeCount
		)
	else
		LatestSoundName = ""
		LatestLoudness = 0
		LatestSoundCategory = "QUIET"
		LatestHearingSummary = string.format("Quiet (Active sounds: %d)", activeCount)
	end

	HearingLabel:Set("Hearing: " .. LatestHearingSummary)
end

